{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation date" },
        "accessType": { "type": "string", "enum": ["guest", "user"], "description": "Type of access" },
        "trialEndsAt": { "type": "string", "format": "date-time", "description": "End of 7-day trial" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "inactive", "trial", "guest", "expired"], "description": "Current subscription status" },
        "subscriptionEndsAt": { "type": "string", "format": "date-time", "description": "End of current subscription period" },
        "planId": { "type": "string", "enum": ["monthly", "quarterly", "annual"], "description": "Current subscription plan" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role" },
        "activityLog": { "type": "array", "items": { "type": "string" }, "description": "List of dates (YYYY-MM-DD) when the app was opened" }
      },
      "required": ["uid", "createdAt", "accessType", "subscriptionStatus"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Temporary guest access tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique guest ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "First access date" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Access expiration date (3 days after creation)" }
      },
      "required": ["id", "createdAt", "expiresAt"]
    },
    "Task": {
      "title": "Task",
      "description": "PTE practice task content",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique task ID" },
        "title": { "type": "string", "description": "Task title" },
        "category": { "type": "string", "description": "Task category (e.g., Read Aloud)" },
        "description": { "type": "string", "description": "Task instructions" },
        "section": { "type": "string", "enum": ["speaking", "writing", "reading", "listening"], "description": "PTE section" },
        "type": { "type": "string", "description": "Task type" },
        "prepTime": { "type": "number", "description": "Preparation time in seconds" },
        "recordingTime": { "type": "number", "description": "Recording/Task time in seconds" },
        "prompt": { "type": "string", "description": "Main text or prompt" },
        "transcript": { "type": "string", "description": "Audio transcript" },
        "passage": { "type": "string", "description": "Reading passage" },
        "image": { "type": "string", "description": "Image URL" },
        "hasAudio": { "type": "boolean", "description": "Whether the task has audio" },
        "options": { "type": "array", "items": { "type": "string" }, "description": "Multiple choice options" },
        "correctAnswers": { "type": "array", "items": { "type": "string" }, "description": "Correct answers" },
        "paragraphs": { "type": "array", "items": { "type": "string" }, "description": "Re-order paragraphs" },
        "blanks": { "type": "object", "description": "Fill in the blanks data" },
        "summaryExample": { "type": "string", "description": "Example summary" }
      },
      "required": ["id", "title", "category", "section", "type"]
    },
    "PromoCode": {
      "title": "PromoCode",
      "description": "Subscription promo codes",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "The promo code string" },
        "discountPercent": { "type": "number", "description": "Discount percentage" },
        "description": { "type": "string", "description": "Code description" },
        "isActive": { "type": "boolean", "description": "Whether the code is active" }
      },
      "required": ["code", "discountPercent", "isActive"]
    },
    "TaskAttempt": {
      "title": "TaskAttempt",
      "description": "User attempt for a single task",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "taskId": { "type": "string", "description": "Task ID" },
        "score": { "type": "number", "description": "Score achieved" },
        "response": { "type": "string", "description": "User response (audio base64 or text)" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Completion date" }
      },
      "required": ["userId", "taskId", "score", "completedAt"]
    },
    "MockTestAttempt": {
      "title": "MockTestAttempt",
      "description": "User attempt for a full mock test",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "testId": { "type": "string", "description": "Mock Test ID" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Completion date" },
        "sectionScores": { "type": "object", "description": "Scores for each section" },
        "overallScore": { "type": "number", "description": "Overall score" },
        "taskResponses": { "type": "object", "description": "Responses for each task in the test" }
      },
      "required": ["userId", "testId", "completedAt", "sectionScores", "overallScore"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/guests/{guestId}": {
      "schema": "Guest",
      "description": "Guest access records"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "PTE practice tasks"
    },
    "/promoCodes/{codeId}": {
      "schema": "PromoCode",
      "description": "Subscription promo codes"
    },
    "/task_attempts/{attemptId}": {
      "schema": "TaskAttempt",
      "description": "User task practice attempts"
    },
    "/mock_test_attempts/{attemptId}": {
      "schema": "MockTestAttempt",
      "description": "User mock test attempts"
    }
  }
}
