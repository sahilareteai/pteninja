rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    function isValidUser(data) {
      return data.uid is string &&
             data.createdAt is string &&
             data.accessType in ['guest', 'user'] &&
             data.subscriptionStatus in ['active', 'inactive', 'trial', 'guest', 'expired'] &&
             (!('email' in data) || data.email == null || data.email is string) &&
             (!('displayName' in data) || data.displayName == null || data.displayName is string) &&
             (!('activityLog' in data) || data.activityLog is list) &&
             (!('completedTasks' in data) || data.completedTasks is list) &&
             (!('taskScores' in data) || data.taskScores is map) &&
             (!('mockTestResults' in data) || data.mockTestResults is list) &&
             (!('completedTasksDetailed' in data) || data.completedTasksDetailed is list) &&
             (!('targetScore' in data) || data.targetScore is number) &&
             (!('favoriteWords' in data) || data.favoriteWords is list) &&
             (!('subscriptionEndsAt' in data) || data.subscriptionEndsAt is string) &&
             (!('trialEndsAt' in data) || data.trialEndsAt is string) &&
             (!('role' in data) || data.role in ['user', 'admin']) &&
             (!('planId' in data) || data.planId in ['monthly', 'quarterly', 'annual']);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin') ||
          request.auth.token.email == "sg.analyst93@gmail.com"
        );
    }
    function isValidTask(data) {
      return data.id is string &&
             data.title is string &&
             data.category is string &&
             data.section in ['speaking', 'writing', 'reading', 'listening'];
    }

    function isValidPromoCode(data) {
      return data.code is string &&
             data.discountPercent is number &&
             data.discountPercent >= 0 &&
             data.discountPercent <= 100 &&
             data.isActive is bool;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    // Connection test collection
    match /test/{docId} {
      allow read: if true; // Publicly readable for connection test
    }

    match /users/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && uidUnchanged() && isValidUser(request.resource.data);
      allow update: if (isAuthenticated() && request.auth.uid == userId && uidNotModified() && isValidUser(request.resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /guests/{guestId} {
      allow read: if isOwner(guestId);
      allow create: if isOwner(guestId);
      allow update: if isOwner(guestId);
    }

    match /tasks/{taskId} {
      allow read: if true; // Tasks are publicly readable
      allow write: if isAdmin(); // Only admins can modify tasks
    }

    match /promoCodes/{codeId} {
      allow read: if true; // Promo codes are publicly readable for validation
      allow write: if isAdmin(); // Only admins can modify promo codes
    }

    match /task_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /mock_test_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
