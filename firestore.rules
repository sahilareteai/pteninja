rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt', 'accessType', 'subscriptionStatus']) &&
             data.uid is string &&
             data.createdAt is string &&
             data.accessType in ['guest', 'user'] &&
             data.subscriptionStatus in ['active', 'inactive', 'trial', 'guest', 'expired'];
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    // Connection test collection
    match /test/{docId} {
      allow read: if true; // Publicly readable for connection test
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && uidNotModified() && isValidUser(request.resource.data);
    }

    match /guests/{guestId} {
      allow read: if isOwner(guestId);
      allow create: if isOwner(guestId);
      allow update: if isOwner(guestId);
    }
  }
}
