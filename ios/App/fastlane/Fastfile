default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to Apple TestFlight"
  lane :beta do
    # Authenticate with App Store Connect using API Key
    raw_key = ENV["APPSTORE_PRIVATE_KEY"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    if raw_key && !raw_key.include?("BEGIN PRIVATE KEY")
      require "base64"
      raw_key = Base64.decode64(raw_key)
    end

    key_id = ENV["APPSTORE_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APPSTORE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: raw_key,
      is_key_content_base64: false
    )

    # Create temporary CI keychain on runner to hold certificates
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "fastlane_tmp_password_2026"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    kc_path = lane_context[SharedValues::KEYCHAIN_PATH]
    if kc_path
      if File.exist?("#{kc_path}-db") && !File.exist?(kc_path)
        begin
          File.symlink("#{kc_path}-db", kc_path)
        rescue => e
          UI.message("Symlink notice: #{e.message}")
        end
      end
    end
    resolved_kc = (kc_path && File.exist?(kc_path)) ? kc_path : (kc_path ? "#{kc_path}-db" : nil)

    # Automatically ensure an available distribution certificate slot
    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      all_dist_certs = certs.select { |c| c.certificate_type.to_s.upcase.include?("DISTRIBUTION") }
      UI.message("Current distribution certificates found (#{all_dist_certs.count}): #{all_dist_certs.map { |c| "#{c.id} (#{c.certificate_type})" }.join(', ')}")

      ephemeral_certs = all_dist_certs.reject { |c| c.id == "HHFVY63QS6" }

      while all_dist_certs.count >= 2 && !ephemeral_certs.empty?
        sorted = ephemeral_certs.sort_by { |c| c.expiration_date || "" }
        oldest = sorted.first
        UI.message("Freeing certificate slot: revoking ephemeral distribution cert #{oldest.id} (#{oldest.certificate_type}, expires #{oldest.expiration_date})")
        oldest.delete!
        ephemeral_certs.delete(oldest)
        all_dist_certs.delete(oldest)
      end
    rescue => e
      UI.message("Notice during certificate slot check: #{e.message}")
    end

    get_certificates(
      api_key: api_key,
      keychain_path: resolved_kc,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.pteninja.app"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["sigh_com.pteninja.app_app-store_profile-name"] || ENV["sigh_com.pteninja.app_appstore_profile-name"]

    build_num = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_num,
      xcodeproj: "App.xcodeproj"
    )

    team_id = ENV["APPLE_TEAM_ID"] || "3WJZNVGDTV"
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.pteninja.app" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Update App Review Notes, attach physical device screen recording, and submit for review"
  lane :prepare_submission do
    raw_key = ENV["APPSTORE_PRIVATE_KEY"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    if raw_key && !raw_key.include?("BEGIN PRIVATE KEY")
      require "base64"
      raw_key = Base64.decode64(raw_key)
    end

    key_id = ENV["APPSTORE_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APPSTORE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: raw_key,
      is_key_content_base64: false
    )

    build_number = ENV["BUILD_NUMBER"]
    if build_number.nil? || build_number.strip.empty?
      build_number = "104"
    end
    app_version = ENV["APP_VERSION"] || "1.0"

    UI.message("Preparing & Submitting App Store Version #{app_version} (target build: #{build_number})...")

    require "net/http"
    require "uri"
    require "json"
    require "jwt"
    require "openssl"
    require "digest"

    ec_key = OpenSSL::PKey::EC.new(raw_key)
    jwt_token = JWT.encode(
      {
        iss: issuer_id,
        iat: Time.now.to_i - 60,
        exp: Time.now.to_i + 1100,
        aud: "appstoreconnect-v1"
      },
      ec_key,
      "ES256",
      { kid: key_id, typ: "JWT" }
    )

    asc_req = lambda do |method, path, body = nil|
      url = path.start_with?("http") ? URI(path) : URI("https://api.appstoreconnect.apple.com/v1/#{path.sub(/^\//, '')}")
      http = Net::HTTP.new(url.host, url.port)
      http.use_ssl = true
      req_class = case method.to_s.upcase
                  when "GET" then Net::HTTP::Get
                  when "POST" then Net::HTTP::Post
                  when "PATCH" then Net::HTTP::Patch
                  when "DELETE" then Net::HTTP::Delete
                  end
      req = req_class.new(url)
      req["Authorization"] = "Bearer #{jwt_token}"
      req["Content-Type"] = "application/json"
      req.body = body.to_json if body
      res = http.request(req)
      parsed = begin
        res.body && !res.body.empty? ? JSON.parse(res.body) : {}
      rescue
        { "raw" => res.body }
      end
      [res.code.to_i, parsed]
    end

    review_notes_text = <<~NOTES.strip
      Thank you, Apple Review Team! Below is all requested information (Items 1–6) for Guideline 2.1:

      1. PHYSICAL DEVICE SCREEN RECORDING:
      • Video Link (Google Drive): https://drive.google.com/file/d/1_7VDxVBXlCL61L5ubk1piwSISQgjw-8i/view?usp=sharing (also attached directly in App Review Information Attachments as AppReview_ScreenRecording.mp4).
      • Captured on a physical iPhone running the latest iOS, starting from the Home Screen launch and demonstrating:
        (a) Account registration & sign-in flows (Sign in with Apple, Email/Password registration & login, and Instant Guest mode).
        (b) Core PTE practice flow (Speaking/Writing practice task and real-time AI diagnostic scoring feedback).
        (c) Accessing paid VIP Subscription options & native Apple StoreKit 2 purchase sheet.
        (d) In-app Account Deletion flow: Profile tab -> Red Trash Can ("Delete Account") icon at top-right of the Profile card -> Confirmation dialog -> Permanent account deletion & sign-out.
      • Note on User-Generated Content (UGC): The app does NOT include public or social user-generated content shared between users; all practice recordings and written responses are private to the individual learner for personal exam scoring.

      2. APP PURPOSE, TARGET AUDIENCE & VALUE:
      • Purpose: PTE Ninja is a mobile exam preparation and AI diagnostic practice application for the Pearson Test of English Academic (PTE Academic).
      • Target Audience: International students, professionals, and visa applicants preparing for English proficiency certification.
      • Problem Solved & Value: Traditional PTE coaching is expensive and slow. PTE Ninja provides learners with 20+ exam task types across Speaking, Writing, Reading, and Listening, delivering instant diagnostic feedback on pronunciation, oral fluency, grammar, vocabulary, and content accuracy on the 10–90 PTE scale, plus personalized study plans and mock tests.

      3. INSTRUCTIONS FOR ACCESSING MAIN FEATURES & LOGIN CREDENTIALS:
      • Option A (Instant Guest - No Login Required): Tap "Continue as Guest" / "Instant Guest" on the welcome screen for immediate access to the dashboard and practice question banks.
      • Option B (Sign in with Apple / Email): Tap "Sign in with Apple" or sign up / sign in with any email and password.
      • How to Test Speaking / AI Scoring: From the Dashboard, select "Speaking" -> "Read Aloud" or "Repeat Sentence" -> Tap the Microphone button (grant mic permission) -> Speak the prompt -> Tap Stop/Submit to view the instant AI Scorecard.
      • How to Test VIP Subscriptions: Tap "Upgrade" or "VIP" in the top bar or Profile tab to open the VIP paywall and trigger native Apple StoreKit 2 auto-renewable subscriptions or Offer Code redemption.
      • How to Test Account Deletion: Open the "Profile" tab -> Tap the red Trash Can icon (next to the Log Out button) at the top-right of the user profile card -> Confirm deletion.

      4. EXTERNAL SERVICES, TOOLS & PLATFORMS USED:
      • Authentication: Firebase Authentication (Sign in with Apple, Google Sign-In, Email/Password, and Anonymous Guest Auth).
      • Database: PostgreSQL (Neon Serverless Postgres) for storing question banks, user practice history, study schedules, and vocabulary progress.
      • AI & Speech Evaluation: Google Gemini API / Google Cloud Vertex AI (accessed securely via our HTTPS backend server) to analyze learner speech audio and written essays for pronunciation, fluency, and grammar scoring.
      • Payment Processing (iOS): Native Apple StoreKit 2 (Auto-Renewable Subscriptions) exclusively for all iOS digital purchases.
      • Advertising: Google AdMob SDK (with Apple App Tracking Transparency / SKAdNetwork) for free-tier users.

      5. REGIONAL CONSISTENCY:
      • The app functions consistently across all regions and territories worldwide with no regional restrictions.

      6. REGULATORY & CONTENT AUTHORIZATION:
      • PTE Ninja is an independent educational test-prep tool and does not operate in a regulated medical, financial, or legal industry. All practice prompts and study materials are original educational content created for PTE Ninja.

      Contact: Sahil Gupta | +91-9289063827 | pteninja.support@gmail.com
    NOTES

    UI.message("Review notes length: #{review_notes_text.length} chars (limit: 4000)")

    target_version = nil
    app = nil
    begin
      app = Spaceship::ConnectAPI::App.find("com.pteninja.app")
      if app
        UI.message("Found App ID: #{app.id}")
        target_version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
        if target_version
          UI.message("Found editable App Store Version: #{target_version.id} (#{target_version.version_string})")

          # 1. Ensure latest valid build (104 or latest VALID) is attached
          code_b, body_b = asc_req.call(:get, "builds?filter[app]=#{app.id}&sort=-uploadedDate&limit=10")
          builds = body_b["data"] || []
          UI.message("Available builds: #{builds.map { |b| "#{b.dig('attributes', 'version')} (#{b.dig('attributes', 'processingState')})" }.join(', ')}")
          selected_build = builds.find { |b| b.dig("attributes", "version").to_s == build_number.to_s && b.dig("attributes", "processingState") == "VALID" } || builds.find { |b| b.dig("attributes", "processingState") == "VALID" }
          if selected_build
            b_id = selected_build["id"]
            b_ver = selected_build.dig("attributes", "version")
            asc_req.call(:patch, "appStoreVersions/#{target_version.id}/relationships/build", {
              data: { type: "builds", id: b_id }
            })
            UI.success("Confirmed Build #{b_ver} (#{b_id}) attached to Version #{app_version}!")
          end

          # 2. Update App Store Review Detail Notes & Contact Info
          code_rd, body_rd = asc_req.call(:get, "appStoreVersions/#{target_version.id}/appStoreReviewDetail")
          rd_data = body_rd["data"]
          rd_id = rd_data ? rd_data["id"] : nil

          if rd_id.nil?
            UI.message("Creating AppStoreReviewDetail...")
            code_crd, body_crd = asc_req.call(:post, "appStoreReviewDetails", {
              data: {
                type: "appStoreReviewDetails",
                attributes: {
                  contactFirstName: "Sahil",
                  contactLastName: "Gupta",
                  contactEmail: "pteninja.support@gmail.com",
                  contactPhone: "+91-9289063827",
                  demoAccountRequired: false,
                  notes: review_notes_text
                },
                relationships: {
                  appStoreVersion: { data: { type: "appStoreVersions", id: target_version.id } }
                }
              }
            })
            rd_id = body_crd.dig("data", "id")
          else
            UI.message("Updating AppStoreReviewDetail #{rd_id} with full 6-point Guideline 2.1 response...")
            code_urd, body_urd = asc_req.call(:patch, "appStoreReviewDetails/#{rd_id}", {
              data: {
                type: "appStoreReviewDetails",
                id: rd_id,
                attributes: {
                  contactFirstName: "Sahil",
                  contactLastName: "Gupta",
                  contactEmail: "pteninja.support@gmail.com",
                  contactPhone: "+91-9289063827",
                  demoAccountRequired: false,
                  notes: review_notes_text
                }
              }
            })
            if code_urd >= 200 && code_urd < 300
              UI.success("Updated AppStoreReviewDetail notes successfully!")
            else
              UI.message("Update AppStoreReviewDetail response (#{code_urd}): #{body_urd.to_json}")
            end
          end

          # 3. Upload Physical Device Screen Recording Attachment to AppStoreReviewDetail
          if rd_id
            video_candidates = [
              File.expand_path("AppReview_ScreenRecording.mp4", __dir__),
              "./fastlane/AppReview_ScreenRecording.mp4",
              "./AppReview_ScreenRecording.mp4"
            ]
            video_file = video_candidates.find { |p| File.exist?(p) }
            if video_file
              video_bytes = File.binread(video_file)
              UI.message("Found screen recording file: #{video_file} (#{video_bytes.bytesize} bytes)")

              # Check existing attachments on rd_id
              code_att_list, body_att_list = asc_req.call(:get, "appStoreReviewDetails/#{rd_id}/appStoreReviewAttachments")
              existing_atts = body_att_list["data"] || []
              existing_atts.each do |ea|
                ea_state = ea.dig("attributes", "assetDeliveryState", "state")
                ea_name = ea.dig("attributes", "fileName")
                UI.message("Existing review attachment: #{ea_name} (#{ea['id']}, state: #{ea_state})")
                if ea_state == "FAILED" || ea_name == File.basename(video_file)
                  UI.message("Removing previous attachment #{ea['id']} before uploading fresh copy...")
                  asc_req.call(:delete, "appStoreReviewAttachments/#{ea['id']}")
                end
              end

              UI.message("Reserving AppStoreReviewAttachment for #{File.basename(video_file)} (#{video_bytes.bytesize} bytes)...")
              code_resv, body_resv = asc_req.call(:post, "appStoreReviewAttachments", {
                data: {
                  type: "appStoreReviewAttachments",
                  attributes: {
                    fileName: File.basename(video_file),
                    fileSize: video_bytes.bytesize
                  },
                  relationships: {
                    appStoreReviewDetail: {
                      data: { type: "appStoreReviewDetails", id: rd_id }
                    }
                  }
                }
              })

              if code_resv >= 200 && code_resv < 300 && body_resv["data"]
                att_id = body_resv["data"]["id"]
                ops = body_resv.dig("data", "attributes", "uploadOperations") || []
                UI.message("Uploading #{ops.count} chunk(s) for attachment #{att_id}...")
                ops.each_with_index do |op, idx|
                  op_url = URI(op["url"])
                  op_http = Net::HTTP.new(op_url.host, op_url.port)
                  op_http.use_ssl = true
                  op_http.read_timeout = 120
                  op_http.open_timeout = 60
                  op_req = Net::HTTP::Put.new(op_url)
                  (op["requestHeaders"] || []).each { |h| op_req[h["name"]] = h["value"] }
                  op_req.body = video_bytes.byteslice(op["offset"].to_i, op["length"].to_i)
                  op_res = op_http.request(op_req)
                  UI.message("  Chunk #{idx + 1}/#{ops.count} upload status: #{op_res.code}")
                end

                md5_hex = Digest::MD5.hexdigest(video_bytes)
                code_comm, body_comm = asc_req.call(:patch, "appStoreReviewAttachments/#{att_id}", {
                  data: {
                    type: "appStoreReviewAttachments",
                    id: att_id,
                    attributes: {
                      uploaded: true,
                      sourceFileChecksum: md5_hex
                    }
                  }
                })
                if code_comm >= 200 && code_comm < 300
                  UI.success("Successfully uploaded & committed AppReview_ScreenRecording.mp4 (id: #{att_id}) to App Store Review Information!")
                else
                  UI.message("Commit attachment response (#{code_comm}): #{body_comm.to_json}")
                end
              else
                UI.message("Reserve attachment response (#{code_resv}): #{body_resv.to_json}")
              end
            else
              UI.message("Screen recording file not found in candidates.")
            end
          end

          # Wait briefly for attachment processing
          sleep(5)

          # 4. Resolve Unresolved Review Submission & Submit to App Review
          UI.message("Inspecting Review Submissions for App #{app.id}...")
          code_rs, body_rs = asc_req.call(:get, "apps/#{app.id}/reviewSubmissions?filter[platform]=IOS&include=items")
          rs_list = body_rs["data"] || []
          rs_list.each do |r|
            UI.message(" - ReviewSubmission #{r['id']}: state=#{r.dig('attributes', 'state')}")
          end

          submitted_ok = false

          # Check if there is an UNRESOLVED_ISSUES submission we can resolve and resubmit
          unresolved_sub = rs_list.find { |r| r.dig("attributes", "state") == "UNRESOLVED_ISSUES" }
          if unresolved_sub
            rs_id = unresolved_sub["id"]
            UI.message("Found UNRESOLVED_ISSUES submission #{rs_id}. Fetching items...")
            code_items, body_items = asc_req.call(:get, "reviewSubmissions/#{rs_id}/items")
            items = body_items["data"] || []
            items.each do |item|
              item_id = item["id"]
              item_state = item.dig("attributes", "state")
              UI.message("  Item #{item_id} state: #{item_state} -> setting resolved=true...")
              code_res_item, body_res_item = asc_req.call(:patch, "reviewSubmissionItems/#{item_id}", {
                data: {
                  type: "reviewSubmissionItems",
                  id: item_id,
                  attributes: {
                    resolved: true
                  }
                }
              })
              UI.message("  Resolve item #{item_id} response (#{code_res_item}): #{code_res_item >= 200 && code_res_item < 300 ? 'RESOLVED' : body_res_item.to_json}")
            end

            UI.message("Submitting resolved ReviewSubmission #{rs_id} to App Review...")
            code_sub, body_sub = asc_req.call(:patch, "reviewSubmissions/#{rs_id}", {
              data: {
                type: "reviewSubmissions",
                id: rs_id,
                attributes: {
                  submitted: true
                }
              }
            })
            if code_sub >= 200 && code_sub < 300
              UI.success("Successfully RESUBMITTED ReviewSubmission #{rs_id} to Apple App Review! (State: #{body_sub.dig('data', 'attributes', 'state')})")
              submitted_ok = true
            else
              UI.message("Resubmit #{rs_id} response (#{code_sub}): #{body_sub.to_json}")
            end
          end

          unless submitted_ok
            ready_sub = rs_list.find { |r| r.dig("attributes", "state") == "READY_FOR_REVIEW" }
            if ready_sub.nil?
              UI.message("Creating new ReviewSubmission container...")
              code_crs, body_crs = asc_req.call(:post, "reviewSubmissions", {
                data: {
                  type: "reviewSubmissions",
                  attributes: { platform: "IOS" },
                  relationships: {
                    app: { data: { type: "apps", id: app.id } }
                  }
                }
              })
              ready_sub = body_crs["data"]
            end

            if ready_sub && ready_sub["id"]
              rs_id = ready_sub["id"]
              UI.message("Attaching App Store Version #{target_version.id} to ReviewSubmission #{rs_id}...")
              asc_req.call(:post, "reviewSubmissionItems", {
                data: {
                  type: "reviewSubmissionItems",
                  relationships: {
                    reviewSubmission: { data: { type: "reviewSubmissions", id: rs_id } },
                    appStoreVersion: { data: { type: "appStoreVersions", id: target_version.id } }
                  }
                }
              })

              UI.message("Submitting ReviewSubmission #{rs_id} to App Review...")
              code_sub2, body_sub2 = asc_req.call(:patch, "reviewSubmissions/#{rs_id}", {
                data: {
                  type: "reviewSubmissions",
                  id: rs_id,
                  attributes: {
                    submitted: true
                  }
                }
              })
              if code_sub2 >= 200 && code_sub2 < 300
                UI.success("Successfully SUBMITTED ReviewSubmission #{rs_id} to Apple App Review! (State: #{body_sub2.dig('data', 'attributes', 'state')})")
                submitted_ok = true
              else
                UI.message("Submit #{rs_id} response (#{code_sub2}): #{body_sub2.to_json}")
              end
            end
          end
        end
      end
    rescue => e
      UI.message("Error during submission: #{e.message}\n#{e.backtrace.first(6).join("\n")}")
    end
  end
end
