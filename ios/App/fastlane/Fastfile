default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to Apple TestFlight"
  lane :beta do
    raw_key = ENV["APPSTORE_PRIVATE_KEY"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    if raw_key && !raw_key.include?("BEGIN PRIVATE KEY")
      require "base64"
      raw_key = Base64.decode64(raw_key)
    end

    key_id = ENV["APPSTORE_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APPSTORE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: raw_key,
      is_key_content_base64: false
    )

    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "fastlane_tmp_password_2026"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    kc_path = lane_context[SharedValues::KEYCHAIN_PATH]
    if kc_path
      if File.exist?("#{kc_path}-db") && !File.exist?(kc_path)
        begin
          File.symlink("#{kc_path}-db", kc_path)
        rescue => e
          UI.message("Symlink notice: #{e.message}")
        end
      end
    end
    resolved_kc = (kc_path && File.exist?(kc_path)) ? kc_path : (kc_path ? "#{kc_path}-db" : nil)

    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      all_dist_certs = certs.select { |c| c.certificate_type.to_s.upcase.include?("DISTRIBUTION") }
      ephemeral_certs = all_dist_certs.reject { |c| c.id == "HHFVY63QS6" }

      while all_dist_certs.count >= 2 && !ephemeral_certs.empty?
        sorted = ephemeral_certs.sort_by { |c| c.expiration_date || "" }
        oldest = sorted.first
        oldest.delete!
        ephemeral_certs.delete(oldest)
        all_dist_certs.delete(oldest)
      end
    rescue => e
      UI.message("Notice during certificate slot check: #{e.message}")
    end

    get_certificates(
      api_key: api_key,
      keychain_path: resolved_kc,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.pteninja.app"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["sigh_com.pteninja.app_app-store_profile-name"] || ENV["sigh_com.pteninja.app_appstore_profile-name"]

    build_num = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_num,
      xcodeproj: "App.xcodeproj"
    )

    team_id = ENV["APPLE_TEAM_ID"] || "3WJZNVGDTV"
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.pteninja.app" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Update App Review Notes, attach physical device screen recording, and submit for review"
  lane :prepare_submission do
    raw_key = ENV["APPSTORE_PRIVATE_KEY"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    if raw_key && !raw_key.include?("BEGIN PRIVATE KEY")
      require "base64"
      raw_key = Base64.decode64(raw_key)
    end

    key_id = ENV["APPSTORE_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APPSTORE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: raw_key,
      is_key_content_base64: false
    )

    build_number = ENV["BUILD_NUMBER"]
    if build_number.nil? || build_number.strip.empty?
      build_number = "104"
    end
    app_version = ENV["APP_VERSION"] || "1.0"

    require "net/http"
    require "uri"
    require "json"
    require "jwt"
    require "openssl"
    require "digest"

    ec_key = OpenSSL::PKey::EC.new(raw_key)
    jwt_token = JWT.encode(
      {
        iss: issuer_id,
        iat: Time.now.to_i - 60,
        exp: Time.now.to_i + 1100,
        aud: "appstoreconnect-v1"
      },
      ec_key,
      "ES256",
      { kid: key_id, typ: "JWT" }
    )

    asc_req = lambda do |method, path, body = nil|
      url = path.start_with?("http") ? URI(path) : URI("https://api.appstoreconnect.apple.com/v1/#{path.sub(/^\//, '')}")
      http = Net::HTTP.new(url.host, url.port)
      http.use_ssl = true
      req_class = case method.to_s.upcase
                  when "GET" then Net::HTTP::Get
                  when "POST" then Net::HTTP::Post
                  when "PATCH" then Net::HTTP::Patch
                  when "DELETE" then Net::HTTP::Delete
                  end
      req = req_class.new(url)
      req["Authorization"] = "Bearer #{jwt_token}"
      req["Content-Type"] = "application/json"
      req.body = body.to_json if body
      res = http.request(req)
      parsed = begin
        res.body && !res.body.empty? ? JSON.parse(res.body) : {}
      rescue
        { "raw" => res.body }
      end
      [res.code.to_i, parsed]
    end

    review_notes_text = <<~NOTES.strip
      Thank you, Apple Review Team! Below is all requested information (Items 1-6) for Guideline 2.1:

      1. PHYSICAL DEVICE SCREEN RECORDING:
      - Video Link (Google Drive): https://drive.google.com/file/d/1_7VDxVBXlCL61L5ubk1piwSISQgjw-8i/view?usp=sharing (also attached directly in App Review Attachments as AppReview_ScreenRecording.mp4).
      - Captured on a physical iPhone running the latest iOS, starting from Home Screen launch and showing:
        (a) Account registration & login (Sign in with Apple, Email/Password, and Instant Guest mode).
        (b) Core PTE practice flow (Speaking/Writing practice task and real-time AI scoring feedback).
        (c) Accessing VIP Subscription plans & native Apple StoreKit 2 purchase sheet.
        (d) In-app Account Deletion flow: Profile tab -> Red Trash Can ("Delete Account") icon at top-right of Profile card -> Confirmation dialog -> Permanent account deletion & sign-out.
      - User-Generated Content (UGC): The app has NO public/social UGC shared between users; all practice recordings and written answers are private to the individual learner.

      2. APP PURPOSE, TARGET AUDIENCE & VALUE:
      - Purpose: Mobile exam prep and AI diagnostic practice app for the Pearson Test of English Academic (PTE Academic).
      - Target Audience: International students, professionals, and visa applicants preparing for English certification.
      - Value Provided: Provides 20+ exam task types across Speaking, Writing, Reading, and Listening with instant diagnostic scoring on pronunciation, fluency, grammar, and content on the 10-90 PTE scale, plus study plans and mock tests.

      3. INSTRUCTIONS FOR ACCESSING MAIN FEATURES & LOGIN:
      - Instant Guest (No Login Required): Tap "Continue as Guest" / "Instant Guest" on the welcome screen for immediate access.
      - Sign in with Apple / Email: Tap "Sign in with Apple" or register/sign in with any email and password.
      - Speaking / AI Scoring: Dashboard -> "Speaking" -> "Read Aloud" -> Tap Microphone -> Speak prompt -> Stop/Submit for instant AI Scorecard.
      - VIP Subscriptions: Tap "Upgrade" or "VIP" in the top bar or Profile tab to test native Apple StoreKit 2 subscriptions or Offer Codes.
      - Account Deletion: Open "Profile" tab -> Tap red Trash Can icon (top-right of profile card) -> Confirm deletion.

      4. EXTERNAL SERVICES, TOOLS & PLATFORMS USED:
      - Auth: Firebase Authentication (Sign in with Apple, Google Sign-In, Email/Password, Anonymous Guest Auth).
      - Database: PostgreSQL (Neon Serverless Postgres) for question banks, practice history, study schedules, and progress.
      - AI Evaluation: Google Gemini API / Google Cloud Vertex AI (via our HTTPS backend) to score learner speech audio and essays.
      - Payments (iOS): Native Apple StoreKit 2 (Auto-Renewable Subscriptions) exclusively for all iOS purchases.
      - Ads: Google AdMob SDK (with Apple App Tracking Transparency / SKAdNetwork) for free-tier users.

      5. REGIONAL CONSISTENCY:
      - The app functions consistently across all regions and territories worldwide with no regional restrictions.

      6. REGULATORY & CONTENT AUTHORIZATION:
      - PTE Ninja is an independent educational test-prep tool and does not operate in a regulated medical, financial, or legal industry. All practice prompts and study materials are original educational content created for PTE Ninja.

      Contact: Sahil Gupta | +91-9289063827 | pteninja.support@gmail.com
    NOTES

    UI.message("Review notes length: #{review_notes_text.length} chars, #{review_notes_text.bytesize} bytes (limit: 4000)")

    begin
      app = Spaceship::ConnectAPI::App.find("com.pteninja.app")
      if app
        code_v, body_v = asc_req.call(:get, "apps/#{app.id}/appStoreVersions?filter[platform]=IOS&limit=5")
        versions = body_v["data"] || []
        v_obj = versions.first
        if v_obj
          v_id = v_obj["id"]
          UI.message("AppStoreVersion #{v_id} state: #{v_obj.dig('attributes', 'appStoreState')}")

          code_rd, body_rd = asc_req.call(:get, "appStoreVersions/#{v_id}/appStoreReviewDetail")
          rd_id = body_rd.dig("data", "id")
          if rd_id
            UI.message("Updating AppStoreReviewDetail #{rd_id} notes...")
            code_urd, body_urd = asc_req.call(:patch, "appStoreReviewDetails/#{rd_id}", {
              data: {
                type: "appStoreReviewDetails",
                id: rd_id,
                attributes: {
                  contactFirstName: "Sahil",
                  contactLastName: "Gupta",
                  contactEmail: "pteninja.support@gmail.com",
                  contactPhone: "+91-9289063827",
                  demoAccountRequired: false,
                  notes: review_notes_text
                }
              }
            })
            if code_urd >= 200 && code_urd < 300
              UI.success("Updated AppStoreReviewDetail #{rd_id} with full 6-point Guideline 2.1 notes!")
            else
              UI.message("Update AppStoreReviewDetail response (#{code_urd}): #{body_urd.to_json}")
            end

            code_att_list, body_att_list = asc_req.call(:get, "appStoreReviewDetails/#{rd_id}/appStoreReviewAttachments")
            existing_atts = body_att_list["data"] || []
            existing_atts.each do |ea|
              UI.success("Confirmed Attachment on Review Detail: #{ea.dig('attributes', 'fileName')} (id=#{ea['id']}, state=#{ea.dig('attributes', 'assetDeliveryState', 'state')})")
            end
          end
        end

        code_rs, body_rs = asc_req.call(:get, "apps/#{app.id}/reviewSubmissions?filter[platform]=IOS")
        (body_rs["data"] || []).each do |r|
          UI.message("ReviewSubmission #{r['id']}: state=#{r.dig('attributes', 'state')}, submittedDate=#{r.dig('attributes', 'submittedDate')}")
        end
      end
    rescue => e
      UI.message("Error: #{e.message}")
    end
  end
end
