default_platform(:ios)

platform :ios do
  desc "Build and upload iOS app to Apple TestFlight"
  lane :beta do
    # Authenticate with App Store Connect using API Key
    raw_key = ENV["APPSTORE_PRIVATE_KEY"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    if raw_key && !raw_key.include?("BEGIN PRIVATE KEY")
      require "base64"
      raw_key = Base64.decode64(raw_key)
    end

    key_id = ENV["APPSTORE_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APPSTORE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: raw_key,
      is_key_content_base64: false
    )

    # Create temporary CI keychain on runner to hold certificates
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "fastlane_tmp_password_2026"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    kc_path = lane_context[SharedValues::KEYCHAIN_PATH]
    if kc_path
      if File.exist?("#{kc_path}-db") && !File.exist?(kc_path)
        begin
          File.symlink("#{kc_path}-db", kc_path)
        rescue => e
          UI.message("Symlink notice: #{e.message}")
        end
      end
    end
    resolved_kc = (kc_path && File.exist?(kc_path)) ? kc_path : (kc_path ? "#{kc_path}-db" : nil)

    # Automatically ensure an available distribution certificate slot
    begin
      certs = Spaceship::ConnectAPI::Certificate.all
      all_dist_certs = certs.select { |c| c.certificate_type.to_s.upcase.include?("DISTRIBUTION") }
      UI.message("Current distribution certificates found (#{all_dist_certs.count}): #{all_dist_certs.map { |c| "#{c.id} (#{c.certificate_type})" }.join(', ')}")

      ephemeral_certs = all_dist_certs.reject { |c| c.id == "HHFVY63QS6" }

      # Apple Developer accounts allow a maximum of 2 Distribution certificates.
      # If 2 or more exist, revoke ephemeral CI certificates (protecting HHFVY63QS6) to free a slot for get_certificates
      while all_dist_certs.count >= 2 && !ephemeral_certs.empty?
        sorted = ephemeral_certs.sort_by { |c| c.expiration_date || "" }
        oldest = sorted.first
        UI.message("Freeing certificate slot: revoking ephemeral distribution cert #{oldest.id} (#{oldest.certificate_type}, expires #{oldest.expiration_date})")
        oldest.delete!
        ephemeral_certs.delete(oldest)
        all_dist_certs.delete(oldest)
      end
    rescue => e
      UI.message("Notice during certificate slot check: #{e.message}")
    end

    # Automatically generate or fetch Distribution certificate
    get_certificates(
      api_key: api_key,
      keychain_path: resolved_kc,
      keychain_password: keychain_password
    )

    # Automatically generate or fetch App Store provisioning profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.pteninja.app"
    )

    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["sigh_com.pteninja.app_app-store_profile-name"] || ENV["sigh_com.pteninja.app_appstore_profile-name"]

    # Set build number based on GitHub run number or timestamp
    build_num = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
    increment_build_number(
      build_number: build_num,
      xcodeproj: "App.xcodeproj"
    )

    team_id = ENV["APPLE_TEAM_ID"] || "3WJZNVGDTV"
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    # Build and sign the IPA archive
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.pteninja.app" => profile_name
        }
      }
    )

    # Upload directly to Apple TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Prepare App Store submission: upload screenshots, sync metadata, and attach build (DO NOT submit)"
  lane :prepare_submission do
    # Authenticate with App Store Connect using API Key
    raw_key = ENV["APPSTORE_PRIVATE_KEY"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY_BASE64"] || ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    if raw_key && !raw_key.include?("BEGIN PRIVATE KEY")
      require "base64"
      raw_key = Base64.decode64(raw_key)
    end

    key_id = ENV["APPSTORE_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["APPSTORE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: raw_key,
      is_key_content_base64: false
    )

    build_number = ENV["BUILD_NUMBER"]
    if build_number.nil? || build_number.strip.empty?
      build_number = "99"
    end
    app_version = ENV["APP_VERSION"] || "1.0"

    UI.message("Preparing App Store submission for version #{app_version} (build: #{build_number})...")
    UI.message("Note: submit_for_review is set to FALSE per user instruction.")

    # Ensure App Store Review Detail exists on Apple's servers so deliver does not crash with No data
    target_version = nil
    app = nil
    begin
      app = Spaceship::ConnectAPI::App.find("com.pteninja.app")
      if app
        target_version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
        if target_version
          begin
            rd = target_version.fetch_app_store_review_detail
          rescue => e
            rd = nil
          end

          if rd.nil?
            UI.message("Initializing missing App Store Review Details for version #{app_version}...")
            target_version.create_app_store_review_detail(attributes: {
              contactFirstName: "Sahil",
              contactLastName: "Arora",
              contactEmail: "support@pteninja.com",
              contactPhone: "+91-9289063827",
              demoAccountRequired: false,
              notes: "Please test using one-tap Guest login or Apple Sign-In. Full VIP subscription and question bank access can be tested in-app."
            })
            UI.success("App Store Review Details successfully initialized.")
          else
            UI.message("Updating App Store Review Details contact info for version #{app_version}...")
            begin
              rd.update(attributes: {
                contactFirstName: "Sahil",
                contactLastName: "Arora",
                contactEmail: "support@pteninja.com",
                contactPhone: "+91-9289063827",
                notes: "Please test using one-tap Guest login or Apple Sign-In. Full VIP subscription and question bank access can be tested in-app."
              })
              UI.success("App Store Review Details contact phone updated to +91-9289063827.")
            rescue => e
              UI.message("Notice updating review detail: #{e.message}")
            end
          end
        end
      end
    rescue => e
      UI.message("Notice during review detail initialization: #{e.message}")
    end

    deliver_config = {
      api_key: api_key,
      app_identifier: "com.pteninja.app",
      app_version: app_version,
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      phased_release: false,
      force: true,
      skip_screenshots: false,
      skip_metadata: false,
      skip_review_information: true,
      ignore_language_directory_validation: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      run_precheck_before_submit: false
    }

    if build_number && !build_number.strip.empty? && build_number != "latest"
      deliver_config[:build_number] = build_number.strip
    end

    deliver(deliver_config)

    # Attempt to associate subscription items to the review submission
    begin
      if app && target_version
        UI.message("Checking review submission container for app version #{app_version} and subscriptions...")
        platform_enum = Spaceship::ConnectAPI::Platform::IOS
        
        # Check existing or create review submission container
        review_sub = nil
        begin
          review_sub = app.get_ready_review_submission(platform: platform_enum, includes: "items")
        rescue => e
          UI.message("Notice fetching ready review submission: #{e.message}")
        end

        if review_sub.nil?
          UI.message("Creating new Review Submission container for iOS...")
          begin
            review_sub = app.create_review_submission(platform: platform_enum)
          rescue => cr_err
            UI.message("Review submission creation notice: #{cr_err.message}")
          end
        end

        if review_sub
          UI.message("Review submission container ID: #{review_sub.id}")
          existing_items = review_sub.items || []
          has_version_item = existing_items.any? { |i| i.respond_to?(:app_store_version_id) && i.app_store_version_id == target_version.id }
          
          unless has_version_item
            UI.message("Attaching App Store version #{target_version.id} to review submission...")
            begin
              review_sub.add_app_store_version_to_review_items(app_store_version_id: target_version.id)
              UI.success("Attached version to review submission.")
            rescue => e
              UI.message("Notice attaching version to review items: #{e.message}")
            end
          end

          # Fetch and link subscriptions
          begin
            subs_resp = Spaceship::ConnectAPI.get_subscriptions(app_id: app.id)
            all_subs = subs_resp.to_models || []
            UI.message("Found #{all_subs.count} subscriptions in App Store Connect: #{all_subs.map { |s| s.respond_to?(:product_id) ? s.product_id : s.id }.join(', ')}")
            
            all_subs.each do |sub|
              begin
                UI.message("Associating subscription #{sub.id} to review submission...")
                Spaceship::ConnectAPI.client.post_review_submission_item(
                  review_submission_id: review_sub.id,
                  subscription_id: sub.id
                )
                UI.success("Associated subscription #{sub.id}!")
              rescue => sub_err
                UI.message("Notice associating subscription #{sub.id}: #{sub_err.message}")
              end
            end
          rescue => e
            UI.message("Notice during subscription query: #{e.message}")
          end
        end
      end
    rescue => e
      UI.message("Notice during review submission association: #{e.message}")
    end

    UI.success("App Store Connect submission prepared successfully! Build #{build_number} and all assets are staged.")
    UI.important("The app has NOT been submitted for review. You can now review everything in App Store Connect before submitting.")
  end
end
