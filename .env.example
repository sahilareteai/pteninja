# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY_2 through GEMINI_API_KEY_10: Optional backup keys for automatic rotation.
# When a key hits its quota limit the service rotates to the next available key.
# An alert email is sent to SUPPORT_EMAIL once all keys are exhausted.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# GROQ_API_KEY: Optional key for Groq AI inference (https://console.groq.com/keys).
# When set, Groq is used as the primary, ultra-fast free tier engine for Writing Evaluation
# and Support Chat, falling back to Gemini if rate-limited or unavailable.
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins for API requests.
# Defaults to https://pteninja.vercel.app,https://pteninja.com if not set.
ALLOWED_ORIGINS=

# FIREBASE_SERVICE_ACCOUNT: Required for server-side admin operations (e.g. deleting users).
# Set this to the JSON content of your Firebase service account key file.
# Generate one at: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# ADMIN_EMAILS: Comma-separated list of admin email addresses allowed to perform admin operations.
# Defaults to sg.analyst93@gmail.com if not set.
ADMIN_EMAILS=

# FIREBASE_DATABASE_ID: Firestore database ID to use in Admin SDK calls.
# Defaults to the ID in firebase-applet-config.json if not set.
FIREBASE_DATABASE_ID=

# ─── Customer Support Bot ──────────────────────────────────────────────────────

# SUPPORT_EMAIL: The email address (e.g. a Google Groups address) where support tickets
# are forwarded when a user clicks "Send to Support Team" in the chat bot.
SUPPORT_EMAIL=

# SMTP settings for outgoing email (use any SMTP provider, e.g. SendGrid, Mailgun, AWS SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Alternatively, use Gmail with an App Password (generate at myaccount.google.com/apppasswords).
# If SMTP_HOST/USER/PASS are set they take precedence over the Gmail credentials below.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Email Unsubscribe ──────────────────────────────────────────────────────────

# UNSUBSCRIBE_SECRET: Secret key used to sign HMAC tokens in unsubscribe links.
# Must be a long, random string (e.g. openssl rand -hex 32). Required in production.
# Changing this value will invalidate all previously issued unsubscribe links.
UNSUBSCRIBE_SECRET=

# ─── Weekly Upgrade Email Cron ─────────────────────────────────────────────────

# CRON_SECRET: ****** that must be sent in the Authorization header when
# calling POST /api/send-weekly-upgrade-emails. Vercel Cron Jobs automatically
# include this value when CRON_SECRET is set as an environment variable.
# Use a long random string (e.g. openssl rand -hex 32).
CRON_SECRET=

# ─── Vertex AI (optional — use instead of / alongside GEMINI_API_KEY for higher quotas) ─────────

# VERTEX_AI_API_KEY: A Google Cloud API key with the Vertex AI API enabled.
# This is a Google Cloud API key (created in Cloud Console → APIs & Services → Credentials),
# NOT a Gemini Developer API key. When set, Vertex AI is used as the primary AI provider.
VERTEX_AI_API_KEY=

# VERTEX_AI_SERVICE_ACCOUNT_JSON: Full JSON contents of a Google Cloud service account key file.
# Generate at: Google Cloud Console → IAM & Admin → Service Accounts → Create key (JSON).
# The service account must have the "Vertex AI User" IAM role on your GCP project.
VERTEX_AI_SERVICE_ACCOUNT_JSON=

# VERTEX_AI_LOCATION: GCP region for Vertex AI service-account calls (default: us-central1).
# Set to "global" when using TTS models (gemini-2.5-flash-preview-tts) via service account,
# as TTS preview models require the global endpoint.
VERTEX_AI_LOCATION=
